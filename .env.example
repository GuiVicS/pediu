# ===== Pediu — variáveis de ambiente (copie para .env e preencha; NUNCA versione o .env) =====

# --- Supabase: 3 conexões, uma por role do Postgres (criados pela migration 0001) ---
# Use o POOLER em modo transação (porta 6543). O usuário é  <role>.<ref-do-projeto>
# Ex.: postgresql://app_api.abcdefghij:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
APP_DATABASE_URL=
PLATFORM_DATABASE_URL=
MCP_DATABASE_URL=

# --- Cofre de credenciais (AES-256-GCM). Formato  id:base64(32 bytes)  — a 1ª chave cifra, as demais só decifram (rotação) ---
# Gerar:  node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEYS=

# --- API ---
PORT=3000
BASE_DOMAIN=pediulanchou.com.br
COOKIE_SECURE=true          # em desenvolvimento local (http) use false
TRUST_PROXY=true            # true atrás de Traefik/Easypanel/Cloudflare

# --- Alertas (opcional) ---
# Webhook que recebe os alertas (Slack, Discord com /slack no fim, n8n, Make…). Sem isso, os alertas só aparecem no super admin.
# ALERT_WEBHOOK_URL=

# --- MCP (apps/mcp) ---
# MCP_ALLOWED_ORIGINS=https://app.exemplo.com   # navegadores; clientes MCP não enviam Origin
# O MCP só usa MCP_DATABASE_URL (role mcp_agent). Nunca dê a ele as outras conexões.

# --- Operação (opcional, mas necessário para o fluxo completo) ---
# URL pública da API com https: os gateways chamam os webhooks aqui. Sem ela, os pagamentos só são confirmados pela conciliação (a cada 30 s).
# PUBLIC_API_URL=https://api.pediulanchou.com.br
# Pasta com o build do super admin (apps/platform); a imagem da API já traz um build em /app/platform-ui
# PLATFORM_UI_DIR=/app/platform-ui
# Imagens enviadas: com SUPABASE_URL + SUPABASE_SERVICE_KEY vão para o Supabase Storage (bucket SUPABASE_BUCKET); sem isso, para UPLOADS_DIR (use um volume persistente).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=pediu-public
# UPLOADS_DIR=/data/uploads
# Segredo compartilhado entre a API e o web-edge (mesmo valor nos dois)
# EDGE_SECRET=

# --- Web-edge (serve a loja de cada domínio) ---
# API_URL=http://api:3000                 # endereço interno da API
# EDGE_SECRET=                            # o MESMO valor na API e no edge (openssl rand -hex 32)
# RELEASES_BASE_URL=https://xxxx.supabase.co/storage/v1/object/public/pediu-releases   # de onde o edge baixa as versões publicadas
# RELEASES_DIR=/data/releases             # alternativa: pasta local com web/VERSAO/…
# --- Caddy (só no compose de exemplo) ---
# ACME_EMAIL=voce@empresa.com
# API_HOST=api.pediulanchou.com.br
# MCP_HOST=mcp.pediulanchou.com.br
